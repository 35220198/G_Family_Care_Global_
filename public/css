
:root{
  --green-950:#022c22; --green-900:#064e3b; --green-800:#065f46;
  --green-700:#047857; --green-600:#059669; --green-100:#d1fae5;
  --slate-900:#0f172a; --slate-600:#475569; --slate-500:#64748b;
  --slate-200:#e2e8f0; --white:#fff; --amber:#f59e0b;
}
*{box-sizing:border-box}
body{margin:0;font-family:Poppins,Arial,sans-serif}
.admin-login{
 min-height:100vh;background:linear-gradient(135deg,var(--green-950),var(--green-800),var(--green-600));
 display:flex;align-items:center;justify-content:center;padding:20px
}
.glass{background:rgba(255,255,255,.94);backdrop-filter:blur(18px);box-shadow:0 25px 70px rgba(2,44,34,.18);border-radius:24px}
.login-card{width:min(100%,440px);padding:32px}
.back-link{display:inline-flex;gap:8px;color:var(--green-800);font-weight:700;text-decoration:none;margin-bottom:32px}
.login-brand{text-align:center;margin-bottom:32px}
.shield{margin:auto;width:64px;height:64px;border-radius:16px;background:var(--green-700);color:#fff;display:grid;place-items:center;font-size:24px;box-shadow:0 10px 25px rgba(4,120,87,.25)}
h1{color:var(--slate-900);margin:16px 0 8px;font-size:28px}
.muted{color:var(--slate-500);font-size:14px}
.form-group{display:block;margin-bottom:20px}
.form-group>span{display:block;color:var(--slate-600);font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}
input{width:100%;margin-top:8px;border:1px solid var(--slate-200);border-radius:12px;padding:14px 16px;font:inherit;outline:none}
input:focus{border-color:var(--green-600);box-shadow:0 0 0 4px rgba(16,185,129,.12)}
.password-wrap{position:relative}
.password-wrap input{padding-right:48px}
.show-password{position:absolute;right:10px;top:10px;border:0;background:transparent;color:#94a3b8;padding:8px;cursor:pointer}
.primary-btn{width:100%;border:0;border-radius:12px;background:var(--green-700);color:#fff;font-weight:800;padding:14px;cursor:pointer;box-shadow:0 10px 25px rgba(4,120,87,.18)}
.primary-btn:hover{background:var(--green-800)}
.status{text-align:center;font-size:14px;min-height:20px;margin-top:12px}
.status.error{color:#dc2626;font-weight:700}.status.success{color:var(--green-700);font-weight:700}
.forgot{text-align:center;margin-top:24px}.forgot a{color:var(--green-700);font-weight:700;text-decoration:none}
.admin-header{background:var(--green-950);color:#fff}
.header-inner,.dashboard-main{width:min(1120px,calc(100% - 40px));margin:auto}
.header-inner{padding:16px 0;display:flex;justify-content:space-between;align-items:center}
.brand{font-weight:900}.brand span{color:#fbbf24}
.logout{border:0;border-radius:10px;background:rgba(255,255,255,.1);color:#fff;padding:10px 16px;cursor:pointer}
.dashboard{background:#f8fafc;color:#1e293b;min-height:100vh}
.dashboard-main{padding:40px 0}
.dashboard-top{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:32px}
.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.18em;font-weight:800;color:var(--green-700)}
.dashboard-title{font-size:36px;font-weight:900;margin:8px 0}
.live-btn{display:inline-block;background:var(--green-700);color:#fff;text-decoration:none;font-weight:800;padding:13px 20px;border-radius:12px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:24px;box-shadow:0 3px 10px rgba(15,23,42,.04)}
.card-icon{width:44px;height:44px;border-radius:12px;display:grid;place-items:center}
.green-icon{background:#ecfdf5;color:var(--green-700)}.amber-icon{background:#fffbeb;color:#d97706}.blue-icon{background:#eff6ff;color:#0284c7}
.card h2{margin:16px 0 6px;font-size:18px}.card p{font-size:14px;color:var(--slate-500);line-height:1.6}.card a{display:inline-block;margin-top:16px;color:var(--green-700);font-weight:800;text-decoration:none}
.admin-section{margin-top:32px}
@media(max-width:800px){.cards{grid-template-columns:1fr}.dashboard-top{align-items:flex-start;flex-direction:column}.dashboard-title{font-size:30px}}
